generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  orders   Order[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Int
  orders      Order[] // 中間テーブルがない場合、仮に直接関連付ける形
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  total     Int
}
